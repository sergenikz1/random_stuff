<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/gutter">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- dictate -->
        <LinearLayout
            style="@style/Card"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <View
                    android:id="@+id/pulse"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_mic_active"
                    android:alpha="0" />

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_mic"
                    android:src="@drawable/ic_mic"
                    android:scaleType="centerInside"
                    android:padding="20dp"
                    android:contentDescription="@string/cd_mic" />
            </FrameLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/btn_record"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_field"
                android:padding="14dp"
                android:minHeight="96dp"
                android:text="@string/result_hint"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyButton"
                    style="@style/Ghost"
                    android:layout_weight="1"
                    android:text="@string/btn_copy" />

                <Button
                    android:id="@+id/shareButton"
                    style="@style/Ghost"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/btn_share" />
            </LinearLayout>
        </LinearLayout>

        <!-- keyboard -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/sec_keyboard" />
            <TextView style="@style/CardHint" android:text="@string/keyboard_hint" />

            <Button
                android:id="@+id/enableKeyboard"
                style="@style/Ghost"
                android:layout_marginTop="12dp"
                android:text="@string/btn_enable_keyboard" />

            <Button
                android:id="@+id/chooseKeyboard"
                style="@style/Ghost"
                android:layout_marginTop="8dp"
                android:text="@string/btn_choose_keyboard" />
        </LinearLayout>

        <!-- engine -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/sec_engine" />
            <TextView style="@style/CardHint" android:text="@string/engine_hint" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/engineCloud"
                    style="@style/Chip"
                    android:text="@string/engine_cloud" />

                <TextView
                    android:id="@+id/engineDevice"
                    style="@style/Chip"
                    android:layout_marginStart="8dp"
                    android:text="@string/engine_device" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cloudFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/presetOpenai"
                        style="@style/Chip"
                        android:text="@string/preset_openai" />

                    <TextView
                        android:id="@+id/presetGroq"
                        style="@style/Chip"
                        android:layout_marginStart="8dp"
                        android:text="@string/preset_groq" />
                </LinearLayout>

                <TextView style="@style/FieldLabel" android:text="@string/label_base_url" />

                <EditText
                    android:id="@+id/baseUrl"
                    style="@style/Field"
                    android:inputType="textUri"
                    android:hint="https://api.openai.com/v1"
                    android:autofillHints="" />

                <TextView style="@style/FieldLabel" android:text="@string/label_api_key" />

                <EditText
                    android:id="@+id/apiKey"
                    style="@style/Field"
                    android:inputType="textPassword"
                    android:hint="sk-..."
                    android:autofillHints="" />

                <TextView style="@style/FieldLabel" android:text="@string/label_stt_model" />

                <EditText
                    android:id="@+id/sttModel"
                    style="@style/Field"
                    android:inputType="text"
                    android:hint="whisper-1"
                    android:autofillHints="" />

                <Button
                    android:id="@+id/testButton"
                    style="@style/Ghost"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_test" />

                <TextView
                    android:id="@+id/testResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- language -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/sec_language" />
            <TextView style="@style/CardHint" android:text="@string/language_hint" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/langAuto" style="@style/Chip" android:text="@string/lang_auto" />
                <TextView android:id="@+id/langRu" style="@style/Chip" android:layout_marginStart="8dp" android:text="@string/lang_ru" />
                <TextView android:id="@+id/langEn" style="@style/Chip" android:layout_marginStart="8dp" android:text="@string/lang_en" />
            </LinearLayout>
        </LinearLayout>

        <!-- cleanup -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/sec_cleanup" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cleanupSwitch"
                style="@style/Toggle"
                android:text="@string/cleanup_title" />

            <TextView style="@style/CardHint" android:text="@string/cleanup_hint" />

            <TextView style="@style/FieldLabel" android:text="@string/label_cleanup_model" />

            <EditText
                android:id="@+id/cleanupModel"
                style="@style/Field"
                android:inputType="text"
                android:hint="gpt-4o-mini"
                android:autofillHints="" />
        </LinearLayout>

        <!-- capture -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/sec_capture" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoStopSwitch"
                style="@style/Toggle"
                android:text="@string/autostop_title" />

            <TextView style="@style/CardHint" android:text="@string/autostop_hint" />

            <TextView
                android:id="@+id/silenceLabel"
                style="@style/FieldLabel"
                android:text="@string/sec_capture" />

            <SeekBar
                android:id="@+id/silenceSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="34"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/trailingSwitch"
                style="@style/Toggle"
                android:text="@string/trailing_title" />
        </LinearLayout>

        <!-- dictionary -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/sec_dictionary" />
            <TextView style="@style/CardHint" android:text="@string/dictionary_hint" />

            <EditText
                android:id="@+id/dictionary"
                style="@style/Field"
                android:layout_marginTop="10dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:autofillHints="" />
        </LinearLayout>

        <!-- history -->
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sec_history" />

                <Button
                    android:id="@+id/clearHistory"
                    style="@style/Ghost"
                    android:layout_width="wrap_content"
                    android:text="@string/btn_clear_history" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- about -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/sec_about" />
            <TextView style="@style/CardHint" android:text="@string/about_text" />
            <TextView
                android:id="@+id/versionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
