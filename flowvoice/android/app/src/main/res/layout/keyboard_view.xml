<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ime_height"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="10dp">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/imeLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_off"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/lang_auto"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/imeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/ime_hint_tap"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/imeSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_key"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/cd_settings" />
    </LinearLayout>

    <!-- mic -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <View
            android:id="@+id/imePulse"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_active"
            android:alpha="0" />

        <ImageButton
            android:id="@+id/imeMic"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic"
            android:src="@drawable/ic_mic"
            android:scaleType="centerInside"
            android:padding="18dp"
            android:contentDescription="@string/cd_mic" />
    </FrameLayout>

    <!-- bottom row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/imeSwitch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_key"
            android:src="@drawable/ic_language"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:contentDescription="@string/cd_switch" />

        <Button
            android:id="@+id/imeSpace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_key"
            android:text="@string/key_space"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

        <ImageButton
            android:id="@+id/imeBackspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_key"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:contentDescription="@string/cd_backspace" />

        <ImageButton
            android:id="@+id/imeEnter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_key"
            android:src="@drawable/ic_enter"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:contentDescription="@string/cd_enter" />
    </LinearLayout>
</LinearLayout>
