<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- голосовой поиск на пульте -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Приложение рассчитано на ТВ, но ставится и на обычные Android-боксы -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Scryer обычно работает в домашней сети по http -->
    <application
        android:name=".IntergalacticTvApp"
        android:allowBackup="false"
        android:banner="@drawable/intergalactic_banner"
        android:icon="@drawable/intergalactic_icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.IntergalacticTV">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.IntergalacticTV.Browse"
            android:screenOrientation="landscape"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.IntergalacticTV.GuidedStep"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.IntergalacticTV"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.DetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.IntergalacticTV.Details"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.LibraryActivity"
            android:exported="false"
            android:theme="@style/Theme.IntergalacticTV.VerticalGrid"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.QueueActivity"
            android:exported="false"
            android:theme="@style/Theme.IntergalacticTV.VerticalGrid"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.IntergalacticTV.GuidedStep"
            android:screenOrientation="landscape" />
        <activity android:name=".streaming.StreamingActivity" android:exported="false"
            android:screenOrientation="landscape" android:theme="@style/Theme.IntergalacticTV.Browse" />
        <activity android:name=".streaming.StreamSearchActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <activity android:name=".streaming.WebEpisodesActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <activity android:name=".streaming.StreamPlayerActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <activity android:name=".streaming.SourcesActivity" android:exported="false"
            android:screenOrientation="landscape" android:theme="@style/Theme.IntergalacticTV.GuidedStep" />
        <activity android:name=".update.UpdateActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
