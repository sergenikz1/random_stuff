<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_dark">
    <FrameLayout android:id="@+id/fragment_container"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginBottom="40dp" />
    <TextView android:id="@+id/web_search_status"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:layout_gravity="bottom" android:gravity="center_vertical"
        android:paddingStart="48dp" android:paddingEnd="24dp"
        android:textSize="16sp" android:textColor="@color/text_secondary"
        android:maxLines="2" android:visibility="gone"
        android:accessibilityLiveRegion="polite" />
</FrameLayout>
