# Порт сервера (Next.js и WebSocket на одном порту)
PORT=3000

# Токен бота от @BotFather. Без него работает только гостевой вход в браузере (для разработки).
BOT_TOKEN=
# Имя бота без @ — для ссылок-приглашений t.me/<бот>
BOT_USERNAME=
# Короткое имя мини-приложения из /newapp в @BotFather (t.me/<бот>/<имя>). Можно не задавать.
APP_SHORT_NAME=
# Публичный HTTPS-адрес приложения — для кнопки «Играть» в боте
WEBAPP_URL=https://pushduel.example.com

# Цена премиум-пропуска в звёздах Telegram
PASS_PRICE_STARS=299
# Цель сообщества на неделю (отжиманий)
COMMUNITY_GOAL=20000
# Длительность рейтинговой дуэли, секунд
RANKED_SECONDS=60
# Где хранить данные
DATA_FILE=./data/pushduel.json
# 1 — разрешить гостевой вход при заданном BOT_TOKEN (для отладки вне Telegram)
ALLOW_GUESTS=
# 0 — не запускать long polling бота (если обновления бота забирает другой сервис)
BOT_POLLING=
