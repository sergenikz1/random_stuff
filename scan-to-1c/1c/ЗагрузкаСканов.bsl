// Модуль внешней обработки «Загрузка сканов» для 1С:Бухгалтерии 3.0 (режим «папка обмена»).
//
// Как использовать: в конфигураторе создайте внешнюю обработку, добавьте реквизит
// «КаталогОбмена» (Строка) и вставьте этот текст в модуль объекта. Запускайте
// ЗагрузитьИзКаталога() из формы обработки или регламентного задания.
// Каждый JSON из каталога превращается в непроведённый документ «Поступление (акт, накладная, УПД)»,
// обработанные файлы переносятся в подкаталог «Загружено».

Процедура ЗагрузитьИзКаталога() Экспорт

	Если ПустаяСтрока(КаталогОбмена) Тогда
		ВызватьИсключение "Не указан каталог обмена";
	КонецЕсли;

	КаталогЗагруженных = КаталогОбмена + ПолучитьРазделительПути() + "Загружено";
	СоздатьКаталог(КаталогЗагруженных);

	Для Каждого Файл Из НайтиФайлы(КаталогОбмена, "*.json") Цикл
		Попытка
			Данные = ПрочитатьДанные(Файл.ПолноеИмя);
			Документ = СоздатьПоступление(Данные);
			ПереместитьФайл(Файл.ПолноеИмя, КаталогЗагруженных + ПолучитьРазделительПути() + Файл.Имя);
			Скан = КаталогОбмена + ПолучитьРазделительПути() + Данные.Получить("scan_file");
			Если ЗначениеЗаполнено(Данные.Получить("scan_file")) И Новый Файл(Скан).Существует() Тогда
				ПереместитьФайл(Скан, КаталогЗагруженных + ПолучитьРазделительПути() + Данные.Получить("scan_file"));
			КонецЕсли;
			Сообщить("Загружен " + Файл.Имя + ": " + Документ);
		Исключение
			Сообщить("Ошибка загрузки " + Файл.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьДанные(ИмяФайла)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайла, КодировкаТекста.UTF8);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

Функция СоздатьПоступление(Данные)

	Продавец = Данные.Получить("seller");
	Покупатель = Данные.Получить("buyer");
	ДатаДокумента = ПрочитатьДатуJSON(Данные.Получить("date") + "T00:00:00", ФорматДатыJSON.ISO);

	Контрагент = НайтиИлиСоздатьКонтрагента(Продавец);
	Организация = Справочники.Организации.ПустаяСсылка();
	Если ЗначениеЗаполнено(Покупатель.Получить("inn")) Тогда
		Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН", Покупатель.Получить("inn"));
	КонецЕсли;

	// Повторно тот же документ контрагента не загружаем.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ПоступлениеТоваровУслуг
	|ГДЕ НомерВходящегоДокумента = &Номер И Контрагент = &Контрагент И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Номер", Данные.Получить("number"));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Документ = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	Документ.Дата = ДатаДокумента;
	Если ЗначениеЗаполнено(Организация) Тогда
		Документ.Организация = Организация;
	КонецЕсли;
	Документ.Контрагент = Контрагент;
	Документ.НомерВходящегоДокумента = Данные.Получить("number");
	Документ.ДатаВходящегоДокумента = ДатаДокумента;
	Документ.СуммаДокумента = Данные.Получить("total");
	Документ.Комментарий = "Загружено из скана " + Данные.Получить("scan_file");
	Документ.Записать(РежимЗаписиДокумента.Запись);
	Возврат Документ.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьКонтрагента(Продавец)

	ИНН = Продавец.Получить("inn");
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		ВызватьИсключение "В документе не распознан ИНН продавца";
	КонецЕсли;

	Найденный = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);
	Если ЗначениеЗаполнено(Найденный) Тогда
		Возврат Найденный;
	КонецЕсли;

	Наименование = Продавец.Получить("name");
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = "Контрагент ИНН " + ИНН;
	КонецЕсли;

	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Наименование = Наименование;
	Контрагент.НаименованиеПолное = Наименование;
	Контрагент.ИНН = ИНН;
	Контрагент.КПП = Продавец.Получить("kpp");
	Контрагент.ЮридическоеФизическоеЛицо = ?(СтрДлина(ИНН) = 12,
		Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо,
		Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	Контрагент.Записать();
	Возврат Контрагент.Ссылка;

КонецФункции
